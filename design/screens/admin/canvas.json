  },
  "p2-hc-sticky": {
   "x": 6080,
   "y": 1700,
   "w": 340,
   "fill": "blue",
   "page": "p2",
   "text": "Health check builder. A Clinical reviewer writes a version and a different one approves it. Screener items (PHQ-9, GAD-7) and the safety question are locked: their wording comes from the official EN and FR versions and the safety rule is in every version. Tests use made-up answer sets only; no screen shows a real person's answers. Numbers in brackets are placeholders for clinicians to set."
  },
  "row-states-1": {
