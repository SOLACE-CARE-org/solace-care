{
  "expo": {
    "name": "Solace Care",
    "slug": "solace-care",
    "owner": "solace-care",
    "scheme": "solacecare",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "../design/design-system/assets/Logos/png/solace-care-app-icon-1024.png",
    "ios": {
      "bundleIdentifier": "care.solace.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Solace Care uses the microphone during your sessions.",
        "NSCameraUsageDescription": "Solace Care uses the camera during video sessions.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "bitcode": false
    },
    "android": {
      "package": "care.solace.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.CALL_PHONE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D6A4F",
          "image": "../design/design-system/assets/Logos/png/solace-care-app-icon-512.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      "expo-status-bar",
      "expo-font",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "@config-plugins/react-native-callkeep",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./native-locales/en.json",
      "fr": "./native-locales/fr.json"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "91d650a1-5424-44a3-9e5f-1c9eb4befd31"
      }
    }
  }
}
