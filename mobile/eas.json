{
  "cli": {
    "version": ">= 25.1.1",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.22.3",
      "pnpm": "10.17.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://services.solacecare.space/api",
        "EXPO_PUBLIC_KEYCLOAK_URL": "https://id.solacecare.space"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://services.solacecare.space/api",
        "EXPO_PUBLIC_KEYCLOAK_URL": "https://id.solacecare.space"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
