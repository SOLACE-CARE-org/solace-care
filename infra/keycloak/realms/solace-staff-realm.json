  "clients": [
    {
      "clientId": "solace-admin",
      "name": "Solace admin portal",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${SOLACE_ADMIN_URL:http://localhost:4200}",
      "redirectUris": [
        "${SOLACE_ADMIN_URL:http://localhost:4200}/*"
      ],
      "webOrigins": [
        "${SOLACE_ADMIN_URL:http://localhost:4200}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SOLACE_ADMIN_URL:http://localhost:4200}/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr"
      ]
    },
    {
      "clientId": "core-admin",
      "name": "Core: creates staff accounts and ends sessions on role change",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${SOLACE_CORE_ADMIN_SECRET:core-admin-dev-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "service_account"
      ]
    },
    {
      "clientId": "core-service",
      "name": "Core calling Tracking and AI",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${SOLACE_CORE_SERVICE_SECRET:core-service-dev-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "service_account",
        "ai:moderation.invoke",
        "ai:risk.read",
        "tracking:ping",
        "ai:ping",
        "ai:translation.invoke"
      ]
    },
    {
      "clientId": "tracking-service",
      "name": "Tracking calling Core",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${SOLACE_TRACKING_SERVICE_SECRET:tracking-service-dev-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "service_account",
        "core:booking-access.read",
        "core:taxonomy.read",
        "core:profile-age.read",
        "ai:insight.invoke"
      ]
    },
    {
      "clientId": "ai-service",
      "name": "AI calling Tracking",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${SOLACE_AI_SERVICE_SECRET:ai-service-dev-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "service_account",
        "tracking:summary.read",
        "core:brief-sources.read"
      ]
    },
    {
      "clientId": "keycloak-code-sender",
      "name": "Keycloak: hands sign-in codes to Core",
      "enabled": true,
      "publicClient": false,
